%% marktwo.sty
%% Reusable LaTeX style package based on the Mathematical Paper Template.
%% Compile documents with pdfLaTeX. Load with \usepackage{marktwo}.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{marktwo}[2026/11/07 Mark Two mathematical paper style]

% --------------------------- Dependencies ---------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage{fix-cm}
\RequirePackage{amsmath,amssymb,mathtools,amsthm}
\RequirePackage{geometry}
\RequirePackage{xcolor}
\RequirePackage{microtype}
\RequirePackage{titlesec}
\RequirePackage{titletoc}
\RequirePackage[most]{tcolorbox}
\RequirePackage{fancyhdr}
\RequirePackage{etoolbox}
\RequirePackage{enumitem}
\RequirePackage{hyperref}

% --------------------------- Page geometry ---------------------------
\geometry{
  a4paper,
  left=20mm,
  right=20mm,
  top=22mm,
  bottom=17mm,
  headheight=19pt,
  headsep=5mm,
  footskip=8mm
}

% --------------------------- Colour palette --------------------------
\definecolor{Ink}{HTML}{202B38}
\definecolor{Muted}{HTML}{657181}
\definecolor{Rule}{HTML}{26394D}
\definecolor{Accent}{HTML}{B65B45}
\definecolor{SectionBadge}{HTML}{294B68}
\definecolor{SectionTitle}{HTML}{263D53}
\definecolor{SubsectionTitle}{HTML}{426B70}
\definecolor{TocRule}{HTML}{DCE2E8}

% Each environment pairs a saturated border with a pale, contrasting fill.
\definecolor{Theorem}{HTML}{315C9A}
\definecolor{TheoremBg}{HTML}{FFF4DD}
\definecolor{Lemma}{HTML}{79509B}
\definecolor{LemmaBg}{HTML}{EAF4FB}
\definecolor{Proposition}{HTML}{A94743}
\definecolor{PropositionBg}{HTML}{EAF2FC}
\definecolor{Corollary}{HTML}{28785F}
\definecolor{CorollaryBg}{HTML}{FFF0E5}
\definecolor{Definition}{HTML}{087F83}
\definecolor{DefinitionBg}{HTML}{FFF1E3}
\definecolor{Axiom}{HTML}{76519A}
\definecolor{AxiomBg}{HTML}{EEF5E5}
\definecolor{Example}{HTML}{A65E27}
\definecolor{ExampleBg}{HTML}{EAF4FB}
\definecolor{Remark}{HTML}{586779}
\definecolor{RemarkBg}{HTML}{FFF5E6}
\definecolor{Conjecture}{HTML}{98466E}
\definecolor{ConjectureBg}{HTML}{EAF6F0}
\definecolor{Notation}{HTML}{39764F}
\definecolor{NotationBg}{HTML}{FFF0F1}
\definecolor{Warning}{HTML}{AE403D}
\definecolor{WarningBg}{HTML}{E8F4F8}

% ------------------------- Global typography -------------------------
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.32em}
\setlength{\emergencystretch}{2em}
\color{Ink}

\hypersetup{
  colorlinks=true,
  linkcolor=Ink,
  urlcolor=Theorem,
  citecolor=Muted
}

% -------------------------- Running header ---------------------------
\newcommand{\RunningTitle}{Mathematical Paper}
\newcommand{\RunningAuthor}{Author Name}
\renewcommand{\sectionmark}[1]{\markright{#1}}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\fontfamily{cmss}\selectfont\fontsize{8}{9}\selectfont\color{Muted}\RunningTitle}
\fancyhead[R]{\fontfamily{cmss}\selectfont\fontsize{8}{9}\selectfont\color{Muted}\nouppercase{\rightmark}}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{TocRule}\leaders\hrule height \headrulewidth\hfill}}
\renewcommand{\footrulewidth}{0pt}
\fancyfoot[L]{\fontfamily{cmss}\selectfont\fontsize{8}{9}\selectfont\color{Muted}\RunningAuthor}
\fancyfoot[R]{\fontfamily{cmss}\selectfont\small\bfseries\color{Accent}\thepage}

\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyhead[L]{\fontfamily{cmss}\selectfont\fontsize{8}{9}\selectfont\color{Muted}\RunningTitle}
  \fancyhead[R]{\fontfamily{cmss}\selectfont\fontsize{8}{9}\selectfont\color{Muted}\nouppercase{\rightmark}}
  \renewcommand{\headrulewidth}{0.4pt}
  \renewcommand{\headrule}{\hbox to\headwidth{\color{TocRule}\leaders\hrule height \headrulewidth\hfill}}
  \renewcommand{\footrulewidth}{0pt}
  \fancyfoot[L]{\fontfamily{cmss}\selectfont\fontsize{8}{9}\selectfont\color{Muted}\RunningAuthor}
  \fancyfoot[R]{\fontfamily{cmss}\selectfont\small\bfseries\color{Accent}\thepage}
}

% The first contents page gets its own header; section-opening pages keep
% the normal running title and current section header through the plain style.
\fancypagestyle{toc}{%
  \fancyhf{}
  \fancyhead[L]{\fontfamily{cmss}\selectfont\fontsize{8}{9}\selectfont\color{Muted}Contents}
  \fancyhead[R]{\fontfamily{cmss}\selectfont\fontsize{8}{9}\selectfont\color{Muted}\RunningTitle}
  \renewcommand{\headrulewidth}{0.4pt}
  \renewcommand{\headrule}{\hbox to\headwidth{\color{TocRule}\leaders\hrule height \headrulewidth\hfill}}
  \renewcommand{\footrulewidth}{0pt}
  \fancyfoot[L]{\fontfamily{cmss}\selectfont\fontsize{8}{9}\selectfont\color{Muted}\RunningAuthor}
  \fancyfoot[R]{\fontfamily{cmss}\selectfont\small\bfseries\color{Accent}\thepage}
}
\apptocmd{\tableofcontents}{\thispagestyle{toc}}{}{}

% ----------------------------- Title page ----------------------------
% Usage: \makemathtitle{Title}{Subtitle}{Author}{Affiliation}{Date}
\newcommand{\makemathtitle}[5]{%
  \gdef\RunningTitle{#1}%
  \gdef\RunningAuthor{#3}%
  \hypersetup{pdftitle={#1},pdfauthor={#3}}%
  \thispagestyle{empty}%
  \vspace*{3mm}%
  {\fontencoding{OT1}\fontfamily{cmss}\fontseries{bx}\selectfont
   \fontsize{40}{46}\selectfont\color{black}%
   \begin{minipage}{\textwidth}\raggedright #1\end{minipage}\par}%
  \vspace{2mm}%
  {\fontfamily{cmss}\fontseries{bx}\selectfont
   \fontsize{17}{20}\selectfont\color{Muted}#2\par}%
  \vspace{8mm}%
  {\normalfont\fontsize{10.5}{13}\selectfont\color{Ink}#3\par}%
  \vspace{1.5mm}%
  {\normalfont\fontsize{9.5}{12}\selectfont\color{Muted}#4\par}%
  \vspace{1.5mm}%
  {\normalfont\fontsize{9.5}{12}\selectfont\color{Muted}#5\par}%
  \vspace{7mm}%
  {\color{Rule}\hrule height 0.9pt}\par%
  \vspace{7mm}%
}

% ------------------------- Section hierarchy ------------------------
\titleformat{\section}
  {\fontfamily{cmss}\selectfont\bfseries\Large\color{SectionTitle}}
  {\tcbox[on line,boxsep=0pt,left=6.5pt,right=6.5pt,top=3pt,bottom=3pt,
     colback=SectionBadge,colframe=SectionBadge,boxrule=0pt,arc=2.2mm]
     {\fontfamily{cmss}\selectfont\bfseries\color{white}\thesection}}
  {0.75em}{}
\titlespacing*{\section}{0pt}{1.0em}{0.38em}

\titleformat{\subsection}
  {\fontfamily{cmss}\selectfont\bfseries\large\color{SubsectionTitle}}
  {\fontfamily{cmss}\selectfont\bfseries\color{Accent}\thesubsection}
  {0.65em}{}
\titlespacing*{\subsection}{0pt}{0.7em}{0.2em}

% -------------------------- Table of contents ------------------------
\renewcommand{\contentsname}{Contents}
\setcounter{tocdepth}{2}
\titlecontents{section}
  [0pt]
  {\addvspace{0.8em}\fontfamily{cmss}\selectfont\bfseries\normalsize\color{Ink}}
  {\contentslabel[{}]{0pt}}
  {}
  {\hspace{0.45em}{\color{TocRule}\titlerule*[0.55pc]{.}}\hspace{0.35em}\contentspage}
\titlecontents{subsection}
  [1.8em]
  {\addvspace{0.25em}\fontfamily{cmss}\selectfont\small\color{Muted}}
  {\contentslabel{2.8em}}
  {}
  {\hspace{0.45em}{\color{TocRule}\titlerule*[0.55pc]{.}}\hspace{0.35em}\contentspage}

% ---------------------- Mathematical environments -------------------
\newcounter{mathenv}[section]
\renewcommand{\themathenv}{\thesection.\arabic{mathenv}}

\newenvironment{mathbox}[4]{%
  \refstepcounter{mathenv}%
  \begin{tcolorbox}[
    enhanced,breakable,
    colback=#3,colframe=#2,
    boxrule=0.75pt,arc=2.0mm,
    left=2.8mm,right=2.8mm,top=1.1mm,bottom=1.1mm,
    before skip=0.45em,after skip=0.55em,
    colbacktitle=#3,coltitle=#2,
    fonttitle=\normalfont\bfseries\normalsize,
    title={#1\enspace\themathenv\if\relax\detokenize{#4}\relax\else\enspace (#4).\fi},
    attach title to upper,
    after title={\enspace}
  ]\color{Ink}\ignorespaces
}{%
  \end{tcolorbox}%
}

\newenvironment{theorem}[1][]{\begin{mathbox}{Theorem}{Theorem}{TheoremBg}{#1}}{\end{mathbox}}
\newenvironment{lemma}[1][]{\begin{mathbox}{Lemma}{Lemma}{LemmaBg}{#1}}{\end{mathbox}}
\newenvironment{proposition}[1][]{\begin{mathbox}{Proposition}{Proposition}{PropositionBg}{#1}}{\end{mathbox}}
\newenvironment{corollary}[1][]{\begin{mathbox}{Corollary}{Corollary}{CorollaryBg}{#1}}{\end{mathbox}}
\newenvironment{definition}[1][]{\begin{mathbox}{Definition}{Definition}{DefinitionBg}{#1}}{\end{mathbox}}
\newenvironment{axiom}[1][]{\begin{mathbox}{Axiom}{Axiom}{AxiomBg}{#1}}{\end{mathbox}}
\newenvironment{example}[1][]{\begin{mathbox}{Example}{Example}{ExampleBg}{#1}}{\end{mathbox}}
\newenvironment{remark}[1][]{\begin{mathbox}{Remark}{Remark}{RemarkBg}{#1}}{\end{mathbox}}
\newenvironment{conjecture}[1][]{\begin{mathbox}{Conjecture}{Conjecture}{ConjectureBg}{#1}}{\end{mathbox}}
\newenvironment{notation}[1][]{\begin{mathbox}{Notation}{Notation}{NotationBg}{#1}}{\end{mathbox}}
\newenvironment{warning}[1][]{\begin{mathbox}{Warning}{Warning}{WarningBg}{#1}}{\end{mathbox}}

\renewcommand{\proofname}{\fontfamily{cmss}\selectfont\bfseries\upshape\color{Ink}Proof}
\renewcommand{\qedsymbol}{\textcolor{SectionBadge}{$\square$}}

\endinput
