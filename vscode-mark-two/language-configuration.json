{
  "comments":{"lineComment":"%"},
  "brackets":[["{","}"],["(",")"],["[","]"]],
  "autoClosingPairs":[
    {"open":"{","close":"}"},{"open":"(","close":")"},{"open":"[","close":"]"},
    {"open":"\\(","close":"\\)"},{"open":"\\[","close":"\\]"}
  ],
  "surroundingPairs":[["{","}"],["(",")"],["[","]"]],
  "indentationRules":{
    "increaseIndentPattern":"^\\s*@begin\\s*\\(.*\\)\\s*(?:\\{.*\\})?\\s*$",
    "decreaseIndentPattern":"^\\s*@end\\s*\\(.*\\)\\s*$"
  }
}
