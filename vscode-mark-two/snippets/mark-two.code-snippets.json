{
  "Document title": {
    "prefix": "documenttitle",
    "body": [
      "@documenttitle{${1:Physics}}",
      "${0}"
    ]
  },
  "Folder": {
    "prefix": "folder",
    "body": [
      "@folder{${1:Electromagnetism}}",
      "${0}"
    ]
  },
  "Author": {
    "prefix": "author",
    "body": [
      "@author{${1:Author}}",
      "${0}"
    ]
  },
  "Date": {
    "prefix": "date",
    "body": [
      "@date{${1:26 September 2026}}",
      "${0}"
    ]
  },
